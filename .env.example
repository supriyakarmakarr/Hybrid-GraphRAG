# Use secret values in your cloud provider's environment settings.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database URLs. Use Neon/managed Postgres (sslmode=require), Qdrant Cloud,
# and Neo4j Aura (neo4j+s://) for a hosted demo.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
NEO4J_URL=neo4j+s://YOUR-ID.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# For cloud secrets, replace each PEM newline with the two characters backslash+n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Optional local-only fallback for scripts/generate_keys.py output.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
JWT_EXPIRY_MINUTES=15

# LLM provider and credentials
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0

# FastEmbed model and Qdrant collection dimension
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
QDRANT_COLLECTION=chunks_multilingual_minilm_l12_v1

# Comma-separated exact origins; same-origin Vercel rewrites normally need none.
CORS_ORIGINS=
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt
